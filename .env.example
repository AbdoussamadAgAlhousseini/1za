# =============================================================================
# Variables d'environnement — copier ce fichier en .env.local et compléter.
# Ne jamais versionner .env.local. Aucune vraie valeur ne doit figurer ici.
# =============================================================================

# --- Variables PUBLIQUES (exposées au navigateur, préfixe NEXT_PUBLIC_) -------
# URL du projet Supabase (Project Settings > API > Project URL).
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique « anon » / « publishable ». Elle est protégée par la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique de l'application (sans barre finale), utilisée dans les liens
# de réinitialisation de mot de passe. Ex. https://stade-26-mars.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Variables SERVEUR UNIQUEMENT (jamais de préfixe NEXT_PUBLIC_) -----------
# Clé service_role : contourne la RLS. Utilisée uniquement côté serveur pour
# créer et révoquer les comptes du personnel. NE JAMAIS l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=
